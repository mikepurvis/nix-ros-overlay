diff --git a/CMakeLists.txt b/CMakeLists.txt
index f499433..e0856ca 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -8,7 +8,8 @@ ament_package(
   CONFIG_EXTRAS "ament_cmake_export_libraries-extras.cmake"
 )
 
+ament_package_config_install_dir(_config_install_dir)
 install(
